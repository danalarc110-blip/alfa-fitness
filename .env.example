APP_NAME="Alpha Fitness"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Retención del canal de auditoría; revisar junto con la política legal.
AUDIT_LOG_DAYS=30

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=alpha_fitness
# DB_USERNAME=alfa_fitness_app
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción el código fuerza cookies seguras; configura HTTPS y APP_URL.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Proyecto estudiantil: los campos vacíos se muestran como marcadores de plantilla.
# No inventar una entidad real; completar solo si se adopta para un gimnasio real.
# Cambiar la versión cuando cambien los documentos o datos de esta plantilla.
LEGAL_VERSION=2026-10-05-academico
LEGAL_NOMBRE_RESPONSABLE=
LEGAL_DIRECCION_RESPONSABLE=
LEGAL_CORREO_PRIVACIDAD=
LEGAL_TELEFONO_RESPONSABLE=
LEGAL_PERSONA_CONTACTO=
LEGAL_PROVEEDORES_Y_PAISES=
LEGAL_PLAZO_RETENCION=
LEGAL_CANCELACIONES=
LEGAL_HORARIOS_Y_SERVICIOS=
LEGAL_PROCEDIMIENTO_ACCIDENTES=

VITE_APP_NAME="${APP_NAME}"
